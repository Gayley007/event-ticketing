# Copy to .env and adjust. docker compose reads .env automatically.
# Every value below also has a default in docker-compose.yml.

# --- API Gateway ---
GATEWAY_PORT=8080
GATEWAY_REQUEST_TIMEOUT=10s
GATEWAY_GRPC_CONNECT_TIMEOUT=2s

# --- Event Service (Service B) ---
EVENT_GRPC_PORT=50051
EVENT_DB_NAME=events
EVENT_DB_USER=event_svc
EVENT_DB_PASSWORD=change-me-events

# --- Ticket Service (Service A) ---
TICKET_GRPC_PORT=50052
TICKET_DB_NAME=tickets
TICKET_DB_USER=ticket_svc
TICKET_DB_PASSWORD=change-me-tickets

# --- Resilience: Ticket Service -> Event Service ---
EVENT_CALL_TIMEOUT=1s          # timeout per attempt
EVENT_CALL_MAX_ATTEMPTS=3      # total attempts including the first
EVENT_CALL_BACKOFF=200ms       # first backoff; doubles each retry (+ jitter)
CB_FAILURE_THRESHOLD=3         # consecutive failed calls that open the breaker
CB_OPEN_TIMEOUT=15s            # time the breaker stays open before a trial call
