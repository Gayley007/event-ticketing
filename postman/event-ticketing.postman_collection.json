    {
      "name": "4. Resilience (run `docker compose stop event-service` first)",
      "description": "Skip this folder in a normal run. Stop the Event Service, then send these requests. Restart it with `docker compose start event-service` and wait ~15s for the circuit breaker to close.",
      "item": [
        {
          "name": "Create ticket while Event Service is down -> 503",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets"
              ]
            },
            "description": "First 3 calls: timeout + 3 retries with backoff, then 503. After that the circuit breaker is open and the call fails immediately.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{eventId}}\",\n  \"holder_name\": \"Sonam Choden\",\n  \"holder_email\": \"sonam@rub.edu.bt\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 503\", () => pm.response.to.have.status(503));",
                  "pm.test(\"error code is UNAVAILABLE\", () => pm.expect(pm.response.json().code).to.eql(\"UNAVAILABLE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get ticket while Event Service is down -> 200 fallback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tickets",
                "{{ticketId}}"
              ]
            },
            "description": "Graceful degradation: the ticket comes from Ticket Service's own DB; event details are replaced by a warning."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test(\"fallback: event is null with a warning\", () => { pm.expect(t.event).to.eql(null); pm.expect(t.warning).to.not.be.empty; });"
                ]
              }
            }
          ]
