{
  "info": {
    "_postman_id": "d40c31fd-14a2-46fc-bda3-eb96f0b4d048",
    "name": "Event Ticketing - WEB303 Assignment",
    "description": "REST calls to the API Gateway, which forwards them over gRPC to the Event Service (Service B) and Ticket Service (Service A).\n\nRun folders 1, 2, 3 and 5 in order with the Collection Runner. Folder 4 needs the Event Service to be stopped first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Events (Service B) - CRUD",
      "item": [
        {
          "name": "Create event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "description": "Creates an event. Saves the returned id into {{eventId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tshechu Night Concert\",\n  \"venue\": \"Clock Tower Square, Thimphu\",\n  \"starts_at\": \"{{startsAt}}\",\n  \"capacity\": 5,\n  \"price\": 500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// starts_at must be in the future - compute dates relative to today",
                  "const d = new Date(); d.setDate(d.getDate() + 60); d.setUTCHours(12, 0, 0, 0);",
                  "pm.collectionVariables.set('startsAt', d.toISOString().replace('.000', ''));",
                  "d.setUTCHours(13); pm.collectionVariables.set('startsAtLater', d.toISOString().replace('.000', ''));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "const ev = pm.response.json();",
                  "pm.collectionVariables.set('eventId', ev.id);",
                  "pm.test(\"has generated id\", () => pm.expect(ev.id).to.match(/^[0-9a-f-]{36}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "List events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns an events array\", () => pm.expect(pm.response.json().events).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get event by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"correct event\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"eventId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update event",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            },
            "description": "PUT replaces all editable fields of the event.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tshechu Night Concert\",\n  \"venue\": \"Changlimithang Stadium, Thimphu\",\n  \"starts_at\": \"{{startsAtLater}}\",\n  \"capacity\": 5,\n  \"price\": 650\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"price updated\", () => pm.expect(pm.response.json().price).to.eql(650));"
                ]
              }
            }
          ]
